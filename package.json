{
  "name": "ctc-gallery-viewer",
  "version": "1.8.1",
  "description": "A dependency-free, responsive and accessible image gallery viewer written in vanilla JavaScript",
  "main": "ctc_overlay.js",
  "files": [
    "ctc_overlay.js",
    "ctc_overlay.min.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check ctc_overlay.js && node --check ctc_overlay.min.js",
    "build": "terser ctc_overlay.js --compress --mangle --comments '/^!/' --output ctc_overlay.min.js"
  },
  "keywords": [
    "viewer",
    "gallery",
    "image-viewer",
    "lightbox",
    "vanilla-javascript",
    "accessible",
    "responsive"
  ],
  "author": "UjW0L",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ujw0l/ctc-gallery-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/ujw0l/ctc-gallery-viewer/issues"
  },
  "homepage": "https://ujw0l.github.io/ctc-gallery-viewer1/",
  "devDependencies": {
    "terser": "^5.43.1"
  }
}
